{
  "name": "workbench",
  "version": "0.2.0",
  "private": true,
  "description": "Electron and Three.js renderer for the laboratory workbench.",
  "main": "electron/main.js",
  "scripts": {
    "build:web": "vite build",
    "rebuild:native": "electron-rebuild -f -w stereo-presenter",
    "build": "npm run build:web && npm run rebuild:native",
    "start": "npm run build && electron .",
    "preview": "npm run build && electron .",
    "offscreen": "npm run build && electron . --offscreen",
    "diagnostics": "npm run build && electron . --diagnostics",
    "tracking:debug": "npm run build && electron . --offscreen --tracking-debug",
    "package": "npm run build:web && electron-forge package",
    "make": "npm run build:web && electron-forge make"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.0.1",
    "stereo-presenter": "file:./native/stereo-presenter",
    "three": "latest"
  },
  "devDependencies": {
    "@electron-forge/cli": "latest",
    "@electron-forge/maker-zip": "latest",
    "@electron-forge/plugin-auto-unpack-natives": "latest",
    "@electron/rebuild": "latest",
    "electron": "latest",
    "vite": "latest"
  }
}